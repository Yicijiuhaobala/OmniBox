{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnibox.local/schemas/llm-lab/eval-runner.contract.schema.json",
  "title": "Evaluation runner contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["lab_id", "input", "output"],
  "properties": {
    "lab_id": {"const": "lab.llm.eval_runner"},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_id", "dataset_version", "target_type", "cases", "scorers"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "dataset_version": {"type": "string", "minLength": 1, "maxLength": 50},
        "target_type": {"enum": ["fixture_outputs", "prompt_variant", "rag_retrieval", "tool_pipeline"]},
        "cases": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "object"}},
        "scorers": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "object"}}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset", "items", "summary", "groups"],
      "properties": {
        "dataset": {"type": "object"},
        "items": {"type": "array", "maxItems": 50, "items": {"type": "object"}},
        "summary": {"type": "object"},
        "groups": {"type": "array", "maxItems": 100, "items": {"type": "object"}}
      }
    }
  }
}
